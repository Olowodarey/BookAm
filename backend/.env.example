# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookam?schema=public"

# Secret used to sign admin JWTs — set a long random value in real environments
JWT_SECRET="change-me-in-production"

# Backend HTTP port (frontend expects 4000 by default)
PORT=4000

# Comma-separated origins allowed by CORS
CORS_ORIGIN="http://localhost:3000"

# Seed script: credentials for the initial platform admin account
SEED_ADMIN_EMAIL="admin@bookam.test"
SEED_ADMIN_PHONE="+2348000000001"
SEED_ADMIN_PASSWORD="admin1234"

# Transactional email (verification + password-reset codes) over Gmail SMTP.
# Free for low volume. Create an App Password: Google account → Security →
# 2-Step Verification → App passwords. Leave blank in dev to log codes instead.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# MAIL_FROM="BookAm <you@gmail.com>"   # optional; defaults to GMAIL_USER

# Base URL of the frontend, used to build shareable circle invite links
FRONTEND_URL="http://localhost:3000"

# Seed script: password given to the demo coordinator (+2348011111111)
SEED_COORDINATOR_PASSWORD="alajo1234"

# Seed script: password given to the demo member accounts (e.g. +2348033333333)
SEED_MEMBER_PASSWORD="member1234"

# Seed script: dedicated test accounts (phone + password)
SEED_TEST_COLLECTOR_PHONE="+2348090000001"
SEED_TEST_COLLECTOR_PASSWORD="collector5678"
SEED_TEST_MEMBER_PHONE="+2348090000002"
SEED_TEST_MEMBER_PASSWORD="contributor5678"

# Google OAuth client id for "Sign in with Google" (leave empty to disable;
# the frontend needs the same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=""

# Cloudflare R2 storage for receipt files (proof-of-payment images/PDFs).
# Leave blank in dev to store receipts on local disk (backend/uploads/).
# Dashboard: R2 → create a bucket + an API token (Object Read & Write).
#   R2_ACCOUNT_ID       — Cloudflare account id (from the R2 endpoint URL)
#   R2_ACCESS_KEY_ID    — from the R2 API token
#   R2_SECRET_ACCESS_KEY— from the R2 API token
#   R2_BUCKET           — the bucket name, e.g. bookam-receipts
#   R2_PUBLIC_BASE_URL  — the bucket's public URL (enable Public access → r2.dev,
#                         or a custom domain), e.g. https://pub-xxxx.r2.dev
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""

# WhatsApp Cloud API (Meta) for the optional in-app phone/WhatsApp OTP.
# From developers.facebook.com → your app → WhatsApp → API Setup. Leave blank
# in dev to log the code instead of sending it. WHATSAPP_TEMPLATE_NAME must be
# an APPROVED "Authentication" category template.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_TEMPLATE_NAME="bookam_verification"
WHATSAPP_TEMPLATE_LANG="en_US"
WHATSAPP_API_VERSION="v21.0"
